{
  "permissions": {
    "deny": [
      "Read(~/.adabra/**)",
      "Read(~/.team-agent/token)",
      "Read(~/.config/gh/**)",
      "Read(~/adabra-backups/**)",
      "Read(~/adabra-handover/**)",
      "Read(**/*.db)",
      "Read(**/*.db-wal)",
      "Read(**/*.db-shm)",
      "Bash(cat ~/.adabra/*)",
      "Bash(cat ~/.team-agent/token)",
      "Bash(cat ~/adabra-backups/*)",
      "Bash(cat ~/adabra-handover/*)",
      "Bash(gh auth token:*)",
      "Bash(gh pr merge:*)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(*main.js override*)",
      "Bash(*ops.sh override*)",
      "Bash(*main.js resume*)",
      "Bash(*ops.sh resume*)",
      "Bash(*main.js switch-stop*)",
      "Bash(*ops.sh switch-stop*)",
      "Bash(rm *adabra-control*)",
      "Bash(mv *adabra-control*)",
      "Bash(*> *adabra-control*)",
      "Bash(script *)",
      "Bash(expect *)",
      "Bash(unbuffer *)",
      "Edit(~/.adabra-control/**)",
      "Write(~/.adabra-control/**)",
      "Edit(//opt/adabra-control/**)",
      "Write(//opt/adabra-control/**)"
    ],
    "allow": [
      "Bash(npm test)",
      "Bash(node --test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree list:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(node helper/cli.js status)",
      "Bash(node helper/cli.js tasks)",
      "Bash(node reviewer/main.js status)",
      "Bash(node coordinator/main.js tasks)",
      "Bash(node coordinator/main.js claims)",
      "Bash(service/coordinator-service.sh status)",
      "Bash(service/helper-service.sh status)",
      "Bash(service/reviewer-service.sh status)",
      "Bash(service/ops.sh stop:*)",
      "Bash(service/ops.sh status)",
      "Bash(service/ops.sh check)",
      "Bash(service/ops.sh health)",
      "Bash(service/ops.sh health --last)",
      "Bash(service/health-service.sh status)",
      "Bash(node ops/main.js stop:*)",
      "Bash(node ops/main.js status)",
      "Bash(node ops/main.js check)",
      "Bash(node ops/main.js health)",
      "Bash(node ops/main.js health --last)"
    ]
  }
}
